{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@hono/node-server": ">=1.19.13",
      "@opentelemetry/core": "2.8.0",
      "@protobufjs/utf8": "1.1.1",
      "ajv@^6.14.0": "6.15.0",
      "ajv@^8.9.0": "8.20.0",
      "brace-expansion@^1.1.7": "1.1.15",
      "brace-expansion@^5.0.5": "5.0.6",
      "esbuild": "0.28.1",
      "express-rate-limit": "8.5.2",
      "fast-uri": "3.1.2",
      "flatted": ">=3.4.2",
      "hono": "4.12.27",
      "ip-address": "10.2.0",
      "js-yaml": "4.3.0",
      "path-to-regexp": ">=8.4.2",
      "postcss": "8.5.15",
      "protobufjs": ">=7.5.5 <8",
      "qs": "6.15.3",
      "read-yaml-file": "2.1.0",
      "rollup": ">=4.59.0",
      "vite": ">=8.0.16",
      "ws": "8.21.0",
      "yaml": ">=2.8.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@sentry/cli",
      "sharp",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "read-yaml-file": "2.1.0"
  },
  "lint-staged": {
    "packages/cli/src/**/*.ts": [
      "bash -c 'cd packages/cli && npx tsc --noEmit'"
    ],
    "packages/core/src/**/*.ts": [
      "bash -c 'cd packages/core && npx tsc --noEmit'"
    ],
    "packages/ai-sdk/src/**/*.ts": [
      "bash -c 'cd packages/ai-sdk && npx tsc --noEmit'"
    ],
    "packages/web/src/**/*.{ts,tsx}": [
      "bash -c 'cd packages/web && npx eslint --max-warnings 0'"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "vite": "^8.0.16"
  }
}
